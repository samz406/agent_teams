{
  "name": "agent-teams-runtime",
  "version": "0.1.0",
  "private": true,
  "author": "Agent Teams",
  "description": "A local-first runtime for coordinating real coding agents across workspaces.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run rebuild:electron && npm run build && electron-builder --dir",
    "smoke:runtime": "npm run rebuild:electron && npm run build && electron scripts/runtime-smoke.mjs --no-sandbox --ozone-platform=headless --disable-gpu",
    "dist": "npm run rebuild:electron && npm run build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "ai.agentteams.runtime",
    "productName": "Agent Teams",
    "asar": true,
    "files": ["out/**/*", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" }
  }
}
